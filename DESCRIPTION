Package: cvmdata
Type: Package
Title: Tidy Access to Brazilian CVM Open Data
Version: 0.3.1
Authors@R:
    person(
      given = "Sidney da Silva Pereira",
      family = "Bissoli",
      email = "sbissoli76@gmail.com",
      role = c("aut", "cre"),
      comment = c(ORCID = "0009-0001-0442-3700")
